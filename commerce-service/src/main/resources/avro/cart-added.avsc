      "type": "long"
    },
    {
      "name": "category",
      "type": "string",
      "doc": "행동 시점의 상품 카테고리 (비정규화)"
    },
    {
      "name": "qty",
      "type": "int"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}